# .gitignore

# === Dependências ===
# A pasta de dependências do Node.js, que é reinstalada com 'npm install'
node_modules/

# === Logs ===
# Arquivos de log gerados pelo npm, yarn ou pela aplicação
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Build / Arquivos Gerados ===
# Pasta de saída do compilador do TypeScript (JavaScript compilado)
dist/

# === Variáveis de Ambiente ===
# Arquivo que contém segredos e configurações de ambiente. NUNCA deve ser versionado.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# === IDEs e Editores ===
# Arquivos de configuração do Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Arquivos do JetBrains (WebStorm, IntelliJ)
.idea/

# Arquivos do Sublime Text
*.sublime-project
*.sublime-workspace

# === Sistema Operacional ===
# Arquivos de metadados do macOS
.DS_Store
.AppleDouble
.LSOverride

# Arquivos de cache de miniaturas do Windows
Thumbs.db
ehthumbs.db

# === Relatórios de Teste ===
# Pasta gerada por frameworks de teste como Jest
coverage/